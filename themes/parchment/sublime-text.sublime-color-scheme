{
  "name": "Parchment",
  "author": "gloam (generated from parchment.json)",
  "variables": {
    "background": "#E8D6B4",
    "foreground": "#2A1E12",
    "primary": "#4A2E12",
    "accent": "#7A3A10",
    "muted": "#6B5A48",
    "error": "#8B2020",
    "string_col": "#387830",
    "number_col": "#7A3A10",
    "constant_col": "#784890",
    "warning_col": "#785A10",
    "dim_bg": "#4A3828"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#7A3A10",
    "invisibles": "#6B5A4860",
    "line_highlight": "#4A382880",
    "selection": "#D4BEA0",
    "selection_foreground": "#2A1E12",
    "selection_border": "#4A2E1240",
    "inactive_selection": "#D4BEA080",
    "inactive_selection_foreground": "#2A1E1280",
    "find_highlight": "#4A2E1240",
    "find_highlight_foreground": "#2A1E12",
    "brackets_foreground": "#6B5A48",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#6B5A48",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#7A3A10",
    "tags_options": "stippled_underline",
    "highlight": "#4A2E1230",
    "active_guide": "#6B5A4880",
    "stack_guide": "#6B5A4850",
    "guide": "#6B5A4830",
    "gutter": "#E8D6B4",
    "gutter_foreground": "#6B5A48",
    "gutter_foreground_highlight": "#2A1E12",
    "line_diff_added": "#387830",
    "line_diff_modified": "#4A2E12",
    "line_diff_deleted": "#8B2020"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#6B5A48",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#7A3A10"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#4A2E12"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#4A2E12"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#387830"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#7A3A10"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#7A3A10"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#784890"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#784890"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#2A1E12"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#2A1E12",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#6B5A48"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#6B5A48"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#4A2E12"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#7A3A10"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#4A2E12"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#4A2E12",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#28407A",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#387830"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#387830"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#7A3A10"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#387830"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#8B2020"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#4A2E12"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#8B2020",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#785A10",
      "font_style": "underline"
    }
  ]
}
