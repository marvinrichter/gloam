{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#4A2E12",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "folder_separator_icon": "/"
          },
          "template": " <b>{{ .Path }}</b> "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#7A3A10",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#6B5A48",
          "properties": {
            "threshold": 2000,
            "style": "round"
          },
          "template": " ◆ {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#6B5A48",
          "properties": {
            "time_format": "15:04"
          },
          "template": " ${prompt.timePrefix} {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#7A3A10",
          "foreground_templates": [
            "{{ if gt .Code 0 }}${t.error}{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "› "
        }
      ]
    }
  ],
  "palette": {
    "background": "#E8D6B4",
    "foreground": "#2A1E12",
    "primary": "#4A2E12",
    "accent": "#7A3A10",
    "muted": "#6B5A48",
    "error": "#8B2020"
  }
}
