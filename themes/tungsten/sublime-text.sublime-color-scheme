{
  "name": "Tungsten",
  "author": "gloam (generated from tungsten.json)",
  "variables": {
    "background": "#0E0C09",
    "foreground": "#F4EED8",
    "primary": "#F0D890",
    "accent": "#5A90C8",
    "muted": "#887A60",
    "error": "#E05858",
    "string_col": "#68A860",
    "number_col": "#F0D890",
    "constant_col": "#A078C8",
    "warning_col": "#C0A840",
    "dim_bg": "#1E1A14"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#5A90C8",
    "invisibles": "#887A6060",
    "line_highlight": "#1E1A1480",
    "selection": "#1C1810",
    "selection_foreground": "#F4EED8",
    "selection_border": "#F0D89040",
    "inactive_selection": "#1C181080",
    "inactive_selection_foreground": "#F4EED880",
    "find_highlight": "#F0D89040",
    "find_highlight_foreground": "#F4EED8",
    "brackets_foreground": "#887A60",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#887A60",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#5A90C8",
    "tags_options": "stippled_underline",
    "highlight": "#F0D89030",
    "active_guide": "#887A6080",
    "stack_guide": "#887A6050",
    "guide": "#887A6030",
    "gutter": "#0E0C09",
    "gutter_foreground": "#887A60",
    "gutter_foreground_highlight": "#F4EED8",
    "line_diff_added": "#68A860",
    "line_diff_modified": "#F0D890",
    "line_diff_deleted": "#E05858"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#887A60",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#5A90C8"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#F0D890"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#F0D890"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#68A860"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#5A90C8"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#F0D890"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#A078C8"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#A078C8"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#F4EED8"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#F4EED8",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#887A60"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#887A60"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#F0D890"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#5A90C8"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#F0D890"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#F0D890",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#5A90C8",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#68A860"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#68A860"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#5A90C8"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#68A860"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#E05858"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#F0D890"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#E05858",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#C0A840",
      "font_style": "underline"
    }
  ]
}
