{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#808888",
          "template": "╭"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#C4B8C8",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "folder_separator_icon": "/"
          },
          "template": " <b>{{ .Path }}</b> "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#D8C8A0",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#808888",
          "properties": {
            "threshold": 2000,
            "style": "round"
          },
          "template": " ◆ {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#808888",
          "properties": {
            "time_format": "15:04"
          },
          "template": " ${prompt.timePrefix} {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#808888",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#D8C8A0",
          "foreground_templates": [
            "{{ if gt .Code 0 }}${t.error}{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "❯ "
        }
      ]
    }
  ],
  "palette": {
    "background": "#0C0C0C",
    "foreground": "#E0E0E0",
    "primary": "#C4B8C8",
    "accent": "#D8C8A0",
    "muted": "#808888",
    "error": "#C86060"
  }
}
