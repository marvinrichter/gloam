{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Stark",
  "author": "gloam",
  "themes": [
    {
      "name": "Stark",
      "appearance": "light",
      "style": {
        "background": "#FFFFFF",
        "foreground": "#000000",
        "editor.background": "#FFFFFF",
        "editor.foreground": "#000000",
        "editor.line_number": "#3A3A3A",
        "editor.active_line_number": "#000000",
        "editor.selection.background": "#E0E0E0",
        "terminal.background": "#FFFFFF",
        "terminal.foreground": "#000000",
        "terminal.cursor": "#8C3000",
        "terminal.cursor_text": "#FFFFFF",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.red": "#880000",
        "terminal.ansi.green": "#005500",
        "terminal.ansi.yellow": "#885500",
        "terminal.ansi.blue": "#000088",
        "terminal.ansi.magenta": "#880088",
        "terminal.ansi.cyan": "#008888",
        "terminal.ansi.white": "#888888",
        "terminal.ansi.bright_black": "#444444",
        "terminal.ansi.bright_red": "#8C0000",
        "terminal.ansi.bright_green": "#007700",
        "terminal.ansi.bright_yellow": "#001A8C",
        "terminal.ansi.bright_blue": "#3A3A3A",
        "terminal.ansi.bright_magenta": "#9900AA",
        "terminal.ansi.bright_cyan": "#0077AA",
        "terminal.ansi.bright_white": "#FFFFFF",
        "border": "#3A3A3A",
        "border.focused": "#001A8C",
        "panel.background": "#444444",
        "element.hover": "#E0E0E0",
        "ghost_element.hover": "#E0E0E0",
        "link_text_hover": "#000088",
        "syntax": {
          "keyword": {
            "color": "#8C3000"
          },
          "type": {
            "color": "#001A8C"
          },
          "class": {
            "color": "#001A8C"
          },
          "function": {
            "color": "#001A8C"
          },
          "string": {
            "color": "#007700"
          },
          "number": {
            "color": "#001A8C"
          },
          "comment": {
            "color": "#3A3A3A",
            "font_style": "italic"
          },
          "variable": {
            "color": "#000000"
          },
          "constant": {
            "color": "#9900AA"
          },
          "operator": {
            "color": "#3A3A3A"
          },
          "punctuation": {
            "color": "#3A3A3A"
          },
          "tag": {
            "color": "#8C3000"
          },
          "attribute": {
            "color": "#001A8C"
          }
        },
        "error.background": "#8C0000",
        "warning.background": "#885500"
      }
    }
  ]
}
