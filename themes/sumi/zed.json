{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Sumi",
  "author": "gloam",
  "themes": [
    {
      "name": "Sumi",
      "appearance": "dark",
      "style": {
        "background": "#0A0B0D",
        "foreground": "#D8D0C0",
        "editor.background": "#0A0B0D",
        "editor.foreground": "#D8D0C0",
        "editor.line_number": "#788090",
        "editor.active_line_number": "#D8D0C0",
        "editor.selection.background": "#181A20",
        "terminal.background": "#0A0B0D",
        "terminal.foreground": "#D8D0C0",
        "terminal.cursor": "#7898B8",
        "terminal.cursor_text": "#0A0B0D",
        "terminal.ansi.black": "#0A0B0D",
        "terminal.ansi.red": "#9A5050",
        "terminal.ansi.green": "#4A8860",
        "terminal.ansi.yellow": "#A09060",
        "terminal.ansi.blue": "#587080",
        "terminal.ansi.magenta": "#806878",
        "terminal.ansi.cyan": "#407880",
        "terminal.ansi.white": "#909090",
        "terminal.ansi.bright_black": "#202428",
        "terminal.ansi.bright_red": "#B86868",
        "terminal.ansi.bright_green": "#60A870",
        "terminal.ansi.bright_yellow": "#8878C8",
        "terminal.ansi.bright_blue": "#788090",
        "terminal.ansi.bright_magenta": "#9078A0",
        "terminal.ansi.bright_cyan": "#5898A8",
        "terminal.ansi.bright_white": "#D8D0C0",
        "border": "#788090",
        "border.focused": "#8878C8",
        "panel.background": "#202428",
        "element.hover": "#181A20",
        "ghost_element.hover": "#181A20",
        "link_text_hover": "#8AB0C8",
        "syntax": {
          "keyword": {
            "color": "#7898B8"
          },
          "type": {
            "color": "#8878C8"
          },
          "class": {
            "color": "#8878C8"
          },
          "function": {
            "color": "#8878C8"
          },
          "string": {
            "color": "#60A870"
          },
          "number": {
            "color": "#8878C8"
          },
          "comment": {
            "color": "#788090",
            "font_style": "italic"
          },
          "variable": {
            "color": "#D8D0C0"
          },
          "constant": {
            "color": "#9078A0"
          },
          "operator": {
            "color": "#788090"
          },
          "punctuation": {
            "color": "#788090"
          },
          "tag": {
            "color": "#7898B8"
          },
          "attribute": {
            "color": "#8878C8"
          }
        },
        "error.background": "#B86868",
        "warning.background": "#A09060"
      }
    }
  ]
}
