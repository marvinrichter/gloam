{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Verdure",
  "author": "gloam",
  "themes": [
    {
      "name": "Verdure",
      "appearance": "dark",
      "style": {
        "background": "#080E08",
        "foreground": "#D0E0C0",
        "editor.background": "#080E08",
        "editor.foreground": "#D0E0C0",
        "editor.line_number": "#709048",
        "editor.active_line_number": "#D0E0C0",
        "editor.selection.background": "#182818",
        "terminal.background": "#080E08",
        "terminal.foreground": "#D0E0C0",
        "terminal.cursor": "#60C848",
        "terminal.cursor_text": "#080E08",
        "terminal.ansi.black": "#0C140C",
        "terminal.ansi.red": "#D06060",
        "terminal.ansi.green": "#60C848",
        "terminal.ansi.yellow": "#C0B840",
        "terminal.ansi.blue": "#6090A8",
        "terminal.ansi.magenta": "#9870C0",
        "terminal.ansi.cyan": "#50C0A0",
        "terminal.ansi.white": "#90A878",
        "terminal.ansi.bright_black": "#203020",
        "terminal.ansi.bright_red": "#E08070",
        "terminal.ansi.bright_green": "#80E058",
        "terminal.ansi.bright_yellow": "#E0D050",
        "terminal.ansi.bright_blue": "#80B0C8",
        "terminal.ansi.bright_magenta": "#B890E0",
        "terminal.ansi.bright_cyan": "#70D8B8",
        "terminal.ansi.bright_white": "#E0F0D0",
        "border": "#709048",
        "border.focused": "#60C848",
        "panel.background": "#203020",
        "element.hover": "#182818",
        "ghost_element.hover": "#182818",
        "link_text_hover": "#90E060",
        "syntax": {
          "keyword": {
            "color": "#90E060"
          },
          "type": {
            "color": "#60C848"
          },
          "class": {
            "color": "#60C848"
          },
          "function": {
            "color": "#60C848"
          },
          "string": {
            "color": "#80E058"
          },
          "number": {
            "color": "#E0D050"
          },
          "comment": {
            "color": "#709048",
            "font_style": "italic"
          },
          "variable": {
            "color": "#D0E0C0"
          },
          "constant": {
            "color": "#B890E0"
          },
          "operator": {
            "color": "#709048"
          },
          "punctuation": {
            "color": "#709048"
          },
          "tag": {
            "color": "#90E060"
          },
          "attribute": {
            "color": "#60C848"
          }
        },
        "error.background": "#D06060",
        "warning.background": "#C0B840"
      }
    }
  ]
}
