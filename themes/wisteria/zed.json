{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Wisteria",
  "author": "gloam",
  "themes": [
    {
      "name": "Wisteria",
      "appearance": "light",
      "style": {
        "background": "#F4F0F8",
        "foreground": "#2A1A40",
        "editor.background": "#F4F0F8",
        "editor.foreground": "#2A1A40",
        "editor.line_number": "#4A3868",
        "editor.active_line_number": "#2A1A40",
        "editor.selection.background": "#D8C8F0",
        "terminal.background": "#F4F0F8",
        "terminal.foreground": "#2A1A40",
        "terminal.cursor": "#4828A0",
        "terminal.cursor_text": "#F4F0F8",
        "terminal.ansi.black": "#F4F0F8",
        "terminal.ansi.red": "#882020",
        "terminal.ansi.green": "#1A5028",
        "terminal.ansi.yellow": "#705010",
        "terminal.ansi.blue": "#2A3888",
        "terminal.ansi.magenta": "#4828A0",
        "terminal.ansi.cyan": "#286080",
        "terminal.ansi.white": "#4A3868",
        "terminal.ansi.bright_black": "#C8B8D8",
        "terminal.ansi.bright_red": "#C04848",
        "terminal.ansi.bright_green": "#287840",
        "terminal.ansi.bright_yellow": "#906820",
        "terminal.ansi.bright_blue": "#3850B8",
        "terminal.ansi.bright_magenta": "#6838C0",
        "terminal.ansi.bright_cyan": "#30809A",
        "terminal.ansi.bright_white": "#2A1A40",
        "border": "#4A3868",
        "border.focused": "#4828A0",
        "panel.background": "#C8B8D8",
        "element.hover": "#D8C8F0",
        "ghost_element.hover": "#D8C8F0",
        "link_text_hover": "#782870",
        "syntax": {
          "keyword": {
            "color": "#782870"
          },
          "type": {
            "color": "#4828A0"
          },
          "class": {
            "color": "#4828A0"
          },
          "function": {
            "color": "#4828A0"
          },
          "string": {
            "color": "#287840"
          },
          "number": {
            "color": "#906820"
          },
          "comment": {
            "color": "#4A3868",
            "font_style": "italic"
          },
          "variable": {
            "color": "#2A1A40"
          },
          "constant": {
            "color": "#6838C0"
          },
          "operator": {
            "color": "#4A3868"
          },
          "punctuation": {
            "color": "#4A3868"
          },
          "tag": {
            "color": "#782870"
          },
          "attribute": {
            "color": "#4828A0"
          }
        },
        "error.background": "#882020",
        "warning.background": "#705010"
      }
    }
  ]
}
