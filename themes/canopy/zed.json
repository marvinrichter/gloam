{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Canopy",
  "author": "gloam",
  "themes": [
    {
      "name": "Canopy",
      "appearance": "dark",
      "style": {
        "background": "#080E0A",
        "foreground": "#D4E0C8",
        "editor.background": "#080E0A",
        "editor.foreground": "#D4E0C8",
        "editor.line_number": "#709068",
        "editor.active_line_number": "#D4E0C8",
        "editor.selection.background": "#101A12",
        "terminal.background": "#080E0A",
        "terminal.foreground": "#D4E0C8",
        "terminal.cursor": "#C8A060",
        "terminal.cursor_text": "#080E0A",
        "terminal.ansi.black": "#080E0A",
        "terminal.ansi.red": "#A05858",
        "terminal.ansi.green": "#4EA858",
        "terminal.ansi.yellow": "#A88840",
        "terminal.ansi.blue": "#406080",
        "terminal.ansi.magenta": "#8058A0",
        "terminal.ansi.cyan": "#3A8878",
        "terminal.ansi.white": "#909880",
        "terminal.ansi.bright_black": "#182018",
        "terminal.ansi.bright_red": "#D06868",
        "terminal.ansi.bright_green": "#60C870",
        "terminal.ansi.bright_yellow": "#90C860",
        "terminal.ansi.bright_blue": "#709068",
        "terminal.ansi.bright_magenta": "#A070B8",
        "terminal.ansi.bright_cyan": "#50A890",
        "terminal.ansi.bright_white": "#D4E0C8",
        "border": "#709068",
        "border.focused": "#90C860",
        "panel.background": "#182018",
        "element.hover": "#101A12",
        "ghost_element.hover": "#101A12",
        "link_text_hover": "#70C898",
        "syntax": {
          "keyword": {
            "color": "#C8A060"
          },
          "type": {
            "color": "#90C860"
          },
          "class": {
            "color": "#90C860"
          },
          "function": {
            "color": "#90C860"
          },
          "string": {
            "color": "#60C870"
          },
          "number": {
            "color": "#90C860"
          },
          "comment": {
            "color": "#709068",
            "font_style": "italic"
          },
          "variable": {
            "color": "#D4E0C8"
          },
          "constant": {
            "color": "#A070B8"
          },
          "operator": {
            "color": "#709068"
          },
          "punctuation": {
            "color": "#709068"
          },
          "tag": {
            "color": "#C8A060"
          },
          "attribute": {
            "color": "#90C860"
          }
        },
        "error.background": "#D06868",
        "warning.background": "#A88840"
      }
    }
  ]
}
