{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Lapis",
  "author": "gloam",
  "themes": [
    {
      "name": "Lapis",
      "appearance": "dark",
      "style": {
        "background": "#060810",
        "foreground": "#D0D8F0",
        "editor.background": "#060810",
        "editor.foreground": "#D0D8F0",
        "editor.line_number": "#6878A8",
        "editor.active_line_number": "#D0D8F0",
        "editor.selection.background": "#101828",
        "terminal.background": "#060810",
        "terminal.foreground": "#D0D8F0",
        "terminal.cursor": "#6090FF",
        "terminal.cursor_text": "#060810",
        "terminal.ansi.black": "#060810",
        "terminal.ansi.red": "#A83838",
        "terminal.ansi.green": "#3080A0",
        "terminal.ansi.yellow": "#4870C0",
        "terminal.ansi.blue": "#304898",
        "terminal.ansi.magenta": "#6048A8",
        "terminal.ansi.cyan": "#3890B8",
        "terminal.ansi.white": "#A0B0E0",
        "terminal.ansi.bright_black": "#151C38",
        "terminal.ansi.bright_red": "#E84040",
        "terminal.ansi.bright_green": "#48A8C8",
        "terminal.ansi.bright_yellow": "#5078F0",
        "terminal.ansi.bright_blue": "#6878A8",
        "terminal.ansi.bright_magenta": "#8868D0",
        "terminal.ansi.bright_cyan": "#60B8E0",
        "terminal.ansi.bright_white": "#D0D8F0",
        "border": "#6878A8",
        "border.focused": "#5078F0",
        "panel.background": "#151C38",
        "element.hover": "#101828",
        "ghost_element.hover": "#101828",
        "link_text_hover": "#90B0FF",
        "syntax": {
          "keyword": {
            "color": "#6090FF"
          },
          "type": {
            "color": "#5078F0"
          },
          "class": {
            "color": "#5078F0"
          },
          "function": {
            "color": "#5078F0"
          },
          "string": {
            "color": "#48A8C8"
          },
          "number": {
            "color": "#5078F0"
          },
          "comment": {
            "color": "#6878A8",
            "font_style": "italic"
          },
          "variable": {
            "color": "#D0D8F0"
          },
          "constant": {
            "color": "#8868D0"
          },
          "operator": {
            "color": "#6878A8"
          },
          "punctuation": {
            "color": "#6878A8"
          },
          "tag": {
            "color": "#6090FF"
          },
          "attribute": {
            "color": "#5078F0"
          }
        },
        "error.background": "#E84040",
        "warning.background": "#4870C0"
      }
    }
  ]
}
