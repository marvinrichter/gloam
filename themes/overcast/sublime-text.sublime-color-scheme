{
  "name": "Overcast",
  "author": "gloam (generated from overcast.json)",
  "variables": {
    "background": "#F0F2F5",
    "foreground": "#181C28",
    "primary": "#4040C8",
    "accent": "#3060C8",
    "muted": "#505870",
    "error": "#C02030",
    "string_col": "#287840",
    "number_col": "#A06020",
    "constant_col": "#7858A0",
    "warning_col": "#705010",
    "dim_bg": "#C8CDD8"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#3060C8",
    "invisibles": "#50587060",
    "line_highlight": "#C8CDD880",
    "selection": "#D0D8F0",
    "selection_foreground": "#181C28",
    "selection_border": "#4040C840",
    "inactive_selection": "#D0D8F080",
    "inactive_selection_foreground": "#181C2880",
    "find_highlight": "#4040C840",
    "find_highlight_foreground": "#181C28",
    "brackets_foreground": "#505870",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#505870",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#3060C8",
    "tags_options": "stippled_underline",
    "highlight": "#4040C830",
    "active_guide": "#50587080",
    "stack_guide": "#50587050",
    "guide": "#50587030",
    "gutter": "#F0F2F5",
    "gutter_foreground": "#505870",
    "gutter_foreground_highlight": "#181C28",
    "line_diff_added": "#287840",
    "line_diff_modified": "#4040C8",
    "line_diff_deleted": "#C02030"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#505870",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#3060C8"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#4040C8"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#4040C8"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#287840"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#3060C8"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#A06020"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#7858A0"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#7858A0"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#181C28"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#181C28",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#505870"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#505870"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#4040C8"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#3060C8"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#4040C8"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#4040C8",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#3060C8",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#287840"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#287840"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#3060C8"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#287840"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#C02030"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#4040C8"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#C02030",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#705010",
      "font_style": "underline"
    }
  ]
}
