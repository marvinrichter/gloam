{
  "name": "Basalt",
  "author": "gloam (generated from basalt.json)",
  "variables": {
    "background": "#090A0B",
    "foreground": "#E0E4E8",
    "primary": "#40D8D8",
    "accent": "#E8B040",
    "muted": "#7888A0",
    "error": "#E05858",
    "string_col": "#40D8D8",
    "number_col": "#C8B050",
    "constant_col": "#607888",
    "warning_col": "#988040",
    "dim_bg": "#181A20"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#E8B040",
    "invisibles": "#7888A060",
    "line_highlight": "#181A2080",
    "selection": "#181A20",
    "selection_foreground": "#E0E4E8",
    "selection_border": "#40D8D840",
    "inactive_selection": "#181A2080",
    "inactive_selection_foreground": "#E0E4E880",
    "find_highlight": "#40D8D840",
    "find_highlight_foreground": "#E0E4E8",
    "brackets_foreground": "#7888A0",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#7888A0",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#E8B040",
    "tags_options": "stippled_underline",
    "highlight": "#40D8D830",
    "active_guide": "#7888A080",
    "stack_guide": "#7888A050",
    "guide": "#7888A030",
    "gutter": "#090A0B",
    "gutter_foreground": "#7888A0",
    "gutter_foreground_highlight": "#E0E4E8",
    "line_diff_added": "#40D8D8",
    "line_diff_modified": "#40D8D8",
    "line_diff_deleted": "#E05858"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#7888A0",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#E8B040"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#40D8D8"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#40D8D8"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#40D8D8"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#E8B040"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#C8B050"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#607888"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#607888"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#E0E4E8"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#E0E4E8",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#7888A0"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#7888A0"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#40D8D8"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#E8B040"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#40D8D8"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#40D8D8",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#40D8D8",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#40D8D8"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#40D8D8"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#E8B040"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#40D8D8"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#E05858"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#40D8D8"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#E05858",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#988040",
      "font_style": "underline"
    }
  ]
}
