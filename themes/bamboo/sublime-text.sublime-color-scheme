{
  "name": "Bamboo",
  "author": "gloam (generated from bamboo.json)",
  "variables": {
    "background": "#090C08",
    "foreground": "#E0DDD4",
    "primary": "#E06848",
    "accent": "#80B8A0",
    "muted": "#888A90",
    "error": "#C86868",
    "string_col": "#68A870",
    "number_col": "#E06848",
    "constant_col": "#A878A8",
    "warning_col": "#A89050",
    "dim_bg": "#182018"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#80B8A0",
    "invisibles": "#888A9060",
    "line_highlight": "#18201880",
    "selection": "#141A12",
    "selection_foreground": "#E0DDD4",
    "selection_border": "#E0684840",
    "inactive_selection": "#141A1280",
    "inactive_selection_foreground": "#E0DDD480",
    "find_highlight": "#E0684840",
    "find_highlight_foreground": "#E0DDD4",
    "brackets_foreground": "#888A90",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#888A90",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#80B8A0",
    "tags_options": "stippled_underline",
    "highlight": "#E0684830",
    "active_guide": "#888A9080",
    "stack_guide": "#888A9050",
    "guide": "#888A9030",
    "gutter": "#090C08",
    "gutter_foreground": "#888A90",
    "gutter_foreground_highlight": "#E0DDD4",
    "line_diff_added": "#68A870",
    "line_diff_modified": "#E06848",
    "line_diff_deleted": "#C86868"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#888A90",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#80B8A0"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#E06848"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#E06848"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#68A870"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#80B8A0"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#E06848"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#A878A8"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#A878A8"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#E0DDD4"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#E0DDD4",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#888A90"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#888A90"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#E06848"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#80B8A0"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#E06848"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#E06848",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#98D0B8",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#68A870"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#68A870"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#80B8A0"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#68A870"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#C86868"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#E06848"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#C86868",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#A89050",
      "font_style": "underline"
    }
  ]
}
