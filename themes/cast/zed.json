{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Cast",
  "author": "gloam",
  "themes": [
    {
      "name": "Cast",
      "appearance": "dark",
      "style": {
        "background": "#101010",
        "foreground": "#C8C8C0",
        "editor.background": "#101010",
        "editor.foreground": "#C8C8C0",
        "editor.line_number": "#888880",
        "editor.active_line_number": "#C8C8C0",
        "editor.selection.background": "#1C1C1C",
        "terminal.background": "#101010",
        "terminal.foreground": "#C8C8C0",
        "terminal.cursor": "#D8C040",
        "terminal.cursor_text": "#101010",
        "terminal.ansi.black": "#101010",
        "terminal.ansi.red": "#A06060",
        "terminal.ansi.green": "#508060",
        "terminal.ansi.yellow": "#909050",
        "terminal.ansi.blue": "#506080",
        "terminal.ansi.magenta": "#786080",
        "terminal.ansi.cyan": "#407880",
        "terminal.ansi.white": "#909088",
        "terminal.ansi.bright_black": "#202020",
        "terminal.ansi.bright_red": "#D85858",
        "terminal.ansi.bright_green": "#68A068",
        "terminal.ansi.bright_yellow": "#C8C060",
        "terminal.ansi.bright_blue": "#888880",
        "terminal.ansi.bright_magenta": "#908090",
        "terminal.ansi.bright_cyan": "#50A0A8",
        "terminal.ansi.bright_white": "#C8C8C0",
        "border": "#888880",
        "border.focused": "#C8C060",
        "panel.background": "#202020",
        "element.hover": "#1C1C1C",
        "ghost_element.hover": "#1C1C1C",
        "link_text_hover": "#90A870",
        "syntax": {
          "keyword": {
            "color": "#D8C040"
          },
          "type": {
            "color": "#C8C060"
          },
          "class": {
            "color": "#C8C060"
          },
          "function": {
            "color": "#C8C060"
          },
          "string": {
            "color": "#68A068"
          },
          "number": {
            "color": "#C8C060"
          },
          "comment": {
            "color": "#888880",
            "font_style": "italic"
          },
          "variable": {
            "color": "#C8C8C0"
          },
          "constant": {
            "color": "#908090"
          },
          "operator": {
            "color": "#888880"
          },
          "punctuation": {
            "color": "#888880"
          },
          "tag": {
            "color": "#D8C040"
          },
          "attribute": {
            "color": "#C8C060"
          }
        },
        "error.background": "#D85858",
        "warning.background": "#909050"
      }
    }
  ]
}
