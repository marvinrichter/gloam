{
  "name": "Boreal",
  "author": "gloam (generated from boreal.json)",
  "variables": {
    "background": "#060A10",
    "foreground": "#C8D8E8",
    "primary": "#18A8C8",
    "accent": "#40D0E0",
    "muted": "#5890A0",
    "error": "#C05868",
    "string_col": "#50C8B0",
    "number_col": "#A8C8E0",
    "constant_col": "#8888D8",
    "warning_col": "#88A8C0",
    "dim_bg": "#182838"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#18A8C8",
    "invisibles": "#5890A060",
    "line_highlight": "#18283880",
    "selection": "#102030",
    "selection_foreground": "#C8D8E8",
    "selection_border": "#18A8C840",
    "inactive_selection": "#10203080",
    "inactive_selection_foreground": "#C8D8E880",
    "find_highlight": "#18A8C840",
    "find_highlight_foreground": "#C8D8E8",
    "brackets_foreground": "#5890A0",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#5890A0",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#40D0E0",
    "tags_options": "stippled_underline",
    "highlight": "#18A8C830",
    "active_guide": "#5890A080",
    "stack_guide": "#5890A050",
    "guide": "#5890A030",
    "gutter": "#060A10",
    "gutter_foreground": "#5890A0",
    "gutter_foreground_highlight": "#C8D8E8",
    "line_diff_added": "#50C8B0",
    "line_diff_modified": "#18A8C8",
    "line_diff_deleted": "#C05868"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#5890A0",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#40D0E0"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#18A8C8"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#18A8C8"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#50C8B0"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#40D0E0"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#A8C8E0"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#8888D8"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#8888D8"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#C8D8E8"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#C8D8E8",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#5890A0"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#5890A0"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#18A8C8"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#40D0E0"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#18A8C8"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#18A8C8",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#40D0E0",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#50C8B0"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#50C8B0"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#40D0E0"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#50C8B0"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#C05868"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#18A8C8"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#C05868",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#88A8C0",
      "font_style": "underline"
    }
  ]
}
