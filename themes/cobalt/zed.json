{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Cobalt",
  "author": "gloam",
  "themes": [
    {
      "name": "Cobalt",
      "appearance": "dark",
      "style": {
        "background": "#080C18",
        "foreground": "#D8E0F0",
        "editor.background": "#080C18",
        "editor.foreground": "#D8E0F0",
        "editor.line_number": "#7888B8",
        "editor.active_line_number": "#D8E0F0",
        "editor.selection.background": "#101828",
        "terminal.background": "#080C18",
        "terminal.foreground": "#D8E0F0",
        "terminal.cursor": "#70D8F0",
        "terminal.cursor_text": "#080C18",
        "terminal.ansi.black": "#080C18",
        "terminal.ansi.red": "#B05060",
        "terminal.ansi.green": "#3878A0",
        "terminal.ansi.yellow": "#8098C8",
        "terminal.ansi.blue": "#4858C8",
        "terminal.ansi.magenta": "#8068B0",
        "terminal.ansi.cyan": "#3898C0",
        "terminal.ansi.white": "#8898C0",
        "terminal.ansi.bright_black": "#182038",
        "terminal.ansi.bright_red": "#D05860",
        "terminal.ansi.bright_green": "#4898A8",
        "terminal.ansi.bright_yellow": "#6878F0",
        "terminal.ansi.bright_blue": "#7888B8",
        "terminal.ansi.bright_magenta": "#9080D0",
        "terminal.ansi.bright_cyan": "#40B8D8",
        "terminal.ansi.bright_white": "#D8E0F0",
        "border": "#7888B8",
        "border.focused": "#6878F0",
        "panel.background": "#182038",
        "element.hover": "#101828",
        "ghost_element.hover": "#101828",
        "link_text_hover": "#80C0F0",
        "syntax": {
          "keyword": {
            "color": "#70D8F0"
          },
          "type": {
            "color": "#6878F0"
          },
          "class": {
            "color": "#6878F0"
          },
          "function": {
            "color": "#6878F0"
          },
          "string": {
            "color": "#4898A8"
          },
          "number": {
            "color": "#6878F0"
          },
          "comment": {
            "color": "#7888B8",
            "font_style": "italic"
          },
          "variable": {
            "color": "#D8E0F0"
          },
          "constant": {
            "color": "#9080D0"
          },
          "operator": {
            "color": "#7888B8"
          },
          "punctuation": {
            "color": "#7888B8"
          },
          "tag": {
            "color": "#70D8F0"
          },
          "attribute": {
            "color": "#6878F0"
          }
        },
        "error.background": "#D05860",
        "warning.background": "#8098C8"
      }
    }
  ]
}
