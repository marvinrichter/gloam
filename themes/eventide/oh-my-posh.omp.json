// Eventide — Oh My Posh theme
// Generated from eventide.json — do not edit by hand
//
// Install: copy to ~/.config/oh-my-posh/themes/eventide.omp.json
//          then set: oh-my-posh init <shell> --config ~/.config/oh-my-posh/themes/eventide.omp.json

{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#8B84C4",
          "template": "╭"
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#8B84C4",
          "template": " {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#E8B86D",
          "properties": {
            "style": "folder",
            "max_depth": 3,
            "folder_separator_icon": "/"
          },
          "template": " <b>{{ .Path }}</b> "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#FF7F57",
          "properties": {
            "branch_icon": " ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#8B84C4",
          "properties": {
            "threshold": 2000,
            "style": "round"
          },
          "template": " ◆ {{ .FormattedMs }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "#8B84C4",
          "properties": {
            "time_format": "15:04"
          },
          "template": " ${prompt.timePrefix} {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#8B84C4",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#FF7F57",
          "foreground_templates": [
            "{{ if gt .Code 0 }}${t.error}{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "❯ "
        }
      ]
    }
  ],
  "palette": {
    "background": "#0D0F1A",
    "foreground": "#F0EAD6",
    "primary": "#E8B86D",
    "accent": "#FF7F57",
    "muted": "#8B84C4",
    "error": "#E85D5D"
  }
}
