{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Ironcast",
  "author": "gloam",
  "themes": [
    {
      "name": "Ironcast",
      "appearance": "dark",
      "style": {
        "background": "#0B0D10",
        "foreground": "#CDD4DC",
        "editor.background": "#0B0D10",
        "editor.foreground": "#CDD4DC",
        "editor.line_number": "#7090A8",
        "editor.active_line_number": "#CDD4DC",
        "editor.selection.background": "#181C24",
        "terminal.background": "#0B0D10",
        "terminal.foreground": "#CDD4DC",
        "terminal.cursor": "#C8D838",
        "terminal.cursor_text": "#0B0D10",
        "terminal.ansi.black": "#0B0D10",
        "terminal.ansi.red": "#B05050",
        "terminal.ansi.green": "#487858",
        "terminal.ansi.yellow": "#9A9050",
        "terminal.ansi.blue": "#4868A0",
        "terminal.ansi.magenta": "#786890",
        "terminal.ansi.cyan": "#407888",
        "terminal.ansi.white": "#909898",
        "terminal.ansi.bright_black": "#1C2028",
        "terminal.ansi.bright_red": "#D05858",
        "terminal.ansi.bright_green": "#60A878",
        "terminal.ansi.bright_yellow": "#78A8C8",
        "terminal.ansi.bright_blue": "#7090A8",
        "terminal.ansi.bright_magenta": "#9880B8",
        "terminal.ansi.bright_cyan": "#50A0B8",
        "terminal.ansi.bright_white": "#CDD4DC",
        "border": "#7090A8",
        "border.focused": "#78A8C8",
        "panel.background": "#1C2028",
        "element.hover": "#181C24",
        "ghost_element.hover": "#181C24",
        "link_text_hover": "#90C8E0",
        "syntax": {
          "keyword": {
            "color": "#C8D838"
          },
          "type": {
            "color": "#78A8C8"
          },
          "class": {
            "color": "#78A8C8"
          },
          "function": {
            "color": "#78A8C8"
          },
          "string": {
            "color": "#60A878"
          },
          "number": {
            "color": "#78A8C8"
          },
          "comment": {
            "color": "#7090A8",
            "font_style": "italic"
          },
          "variable": {
            "color": "#CDD4DC"
          },
          "constant": {
            "color": "#9880B8"
          },
          "operator": {
            "color": "#7090A8"
          },
          "punctuation": {
            "color": "#7090A8"
          },
          "tag": {
            "color": "#C8D838"
          },
          "attribute": {
            "color": "#78A8C8"
          }
        },
        "error.background": "#D05858",
        "warning.background": "#9A9050"
      }
    }
  ]
}
