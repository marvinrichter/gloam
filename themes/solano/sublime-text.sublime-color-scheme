{
  "name": "Solano",
  "author": "gloam (generated from solano.json)",
  "variables": {
    "background": "#F5EDE0",
    "foreground": "#2A1C10",
    "primary": "#782010",
    "accent": "#1A4A7A",
    "muted": "#7A5C40",
    "error": "#8B1A2A",
    "string_col": "#2C7038",
    "number_col": "#782010",
    "constant_col": "#1A4A7A",
    "warning_col": "#5A3008",
    "dim_bg": "#4A3828"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#1A4A7A",
    "invisibles": "#7A5C4060",
    "line_highlight": "#4A382880",
    "selection": "#DDD0BC",
    "selection_foreground": "#2A1C10",
    "selection_border": "#78201040",
    "inactive_selection": "#DDD0BC80",
    "inactive_selection_foreground": "#2A1C1080",
    "find_highlight": "#78201040",
    "find_highlight_foreground": "#2A1C10",
    "brackets_foreground": "#7A5C40",
    "brackets_options": "underline",
    "bracket_contents_foreground": "#7A5C40",
    "bracket_contents_options": "stippled_underline",
    "tags_foreground": "#1A4A7A",
    "tags_options": "stippled_underline",
    "highlight": "#78201030",
    "active_guide": "#7A5C4080",
    "stack_guide": "#7A5C4050",
    "guide": "#7A5C4030",
    "gutter": "#F5EDE0",
    "gutter_foreground": "#7A5C40",
    "gutter_foreground_highlight": "#2A1C10",
    "line_diff_added": "#2C7038",
    "line_diff_modified": "#782010",
    "line_diff_deleted": "#8B1A2A"
  },
  "rules": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "foreground": "#7A5C40",
      "font_style": "italic"
    },
    {
      "name": "Keyword",
      "scope": "keyword, storage.type, storage.modifier, keyword.control",
      "foreground": "#1A4A7A"
    },
    {
      "name": "Type / Class",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class",
      "foreground": "#782010"
    },
    {
      "name": "Function",
      "scope": "entity.name.function, meta.function-call, support.function, variable.function",
      "foreground": "#782010"
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template",
      "foreground": "#2C7038"
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "foreground": "#1A4A7A"
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "foreground": "#782010"
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language, constant.character, variable.language",
      "foreground": "#1A4A7A"
    },
    {
      "name": "User-defined constant",
      "scope": "constant.other, variable.other.constant",
      "foreground": "#1A4A7A"
    },
    {
      "name": "Variable",
      "scope": "variable, variable.other.readwrite",
      "foreground": "#2A1C10"
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "foreground": "#2A1C10",
      "font_style": "italic"
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "foreground": "#7A5C40"
    },
    {
      "name": "Punctuation",
      "scope": "punctuation, punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "#7A5C40"
    },
    {
      "name": "Attribute / Decorator",
      "scope": "entity.other.attribute-name, meta.annotation, variable.annotation",
      "foreground": "#782010"
    },
    {
      "name": "Tag name",
      "scope": "entity.name.tag",
      "foreground": "#1A4A7A"
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
      "foreground": "#782010"
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section",
      "foreground": "#782010",
      "font_style": "bold"
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link",
      "foreground": "#1A4A7A",
      "font_style": "underline"
    },
    {
      "name": "Markdown inline code",
      "scope": "markup.raw.inline",
      "foreground": "#2C7038"
    },
    {
      "name": "Markdown fenced code",
      "scope": "markup.raw.block, markup.fenced_code",
      "foreground": "#2C7038"
    },
    {
      "name": "Markdown list bullet",
      "scope": "punctuation.definition.list_item",
      "foreground": "#1A4A7A"
    },
    {
      "name": "Diff — added",
      "scope": "markup.inserted",
      "foreground": "#2C7038"
    },
    {
      "name": "Diff — removed",
      "scope": "markup.deleted",
      "foreground": "#8B1A2A"
    },
    {
      "name": "Diff — changed",
      "scope": "markup.changed",
      "foreground": "#782010"
    },
    {
      "name": "Error",
      "scope": "invalid, invalid.illegal",
      "foreground": "#8B1A2A",
      "font_style": "underline"
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "foreground": "#5A3008",
      "font_style": "underline"
    }
  ]
}
